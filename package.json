{
  "name": "formbuilder-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace services/api run dev",
    "build": "npm --workspace apps/web run build",
    "lint": "npm --workspace apps/web run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
